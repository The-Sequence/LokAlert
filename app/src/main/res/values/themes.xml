<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LokAlert" parent="android:Theme.Material.Light.NoActionBar" />
    
    <!-- Transparent theme for alarm overlay to see through to what's behind -->
    <style name="Theme.LokAlert.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>